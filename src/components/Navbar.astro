---
import { Icon } from "astro-icon/components";
---

<section id="sect" class="duration-1200 opacity-0">
    <div
        id="menu"
        class="group fixed bottom-0 lg:bottom-auto left-0 right-0 lg:right-auto
        lg:w-fit h-fit z-50 border-y lg:border overflow-visible
        flex"
    >
        <div id="menuBg" class=""></div>

        <div class="md:hidden content-center">
            <Icon
                name="line-md:chevron-left"
                class="w-6 h-6 text-center rounded-e-full"
            />
        </div>
        <div
            class="w-full lg:w-auto justify-between overflow-x-auto overflow-y-visible lg:overflow-visible"
        >
            <div
                id="menuContainer"
                class="flex pe-3 lg:px-2 py-3 justify-around lg:flex-col stretch lg:w-fit justify-between lg:gap-2"
            >
                <a href="#mySite" class="flex items-center cursor-pointer">
                    <div
                        class="flex items-center justify-center min-w-[2.5rem]"
                    >
                        <Icon
                            name="line-md:account"
                            class="w-5 h-6 text-center"
                        />
                    </div>
                    <p
                        class="flex text-[14px] whitespace-nowrap overflow-hidden lg:opacity-0 lg:group-hover:opacity-100 lg:group-hover:w-[var(--max-width)]"
                    >
                        Sobre mi
                    </p>
                </a>

                <a href="#skills" class="flex items-center cursor-pointer">
                    <div
                        class="flex items-center justify-center min-w-[2.5rem]"
                    >
                        <Icon
                            name="line-md:lightbulb-filled"
                            class="w-5 h-6 text-center"
                        />
                    </div>
                    <p
                        class="flex text-[14px] whitespace-nowrap overflow-hidden lg:opacity-0 lg:group-hover:opacity-100 lg:group-hover:w-[var(--max-width)]"
                    >
                        Habilidades
                    </p>
                </a>

                <a href="#projects" class="flex items-center cursor-pointer">
                    <div
                        class="flex items-center justify-center min-w-[2.5rem]"
                    >
                        <Icon
                            name="line-md:briefcase-check-filled"
                            class="w-5 h-6 text-center"
                        />
                    </div>
                    <p
                        class="flex text-[14px] whitespace-nowrap overflow-hidden lg:opacity-0 lg:group-hover:opacity-100 lg:group-hover:w-[var(--max-width)]"
                    >
                        Mis proyectos
                    </p>
                </a>

                <a href="#contact" class="flex items-center cursor-pointer">
                    <div
                        class="flex items-center justify-center min-w-[2.5rem]"
                    >
                        <Icon
                            name="line-md:email"
                            class="w-5 h-6 text-center"
                        />
                    </div>
                    <p
                        class="flex text-[14px] whitespace-nowrap overflow-hidden lg:opacity-0 lg:group-hover:opacity-100 lg:group-hover:w-[var(--max-width)]"
                    >
                        Contacto
                    </p>
                </a>

                <div
                    id="containerCv"
                    class="flex flex-col cursor-pointer group/cv"
                >
                    <div class="flex">
                        <div
                            class="flex items-center justify-center min-w-[2.5rem]"
                        >
                            <Icon
                                name="line-md:text-box-to-text-box-multiple-transition"
                                class="w-5 h-6 text-center"
                            />
                        </div>
                        <p
                            class="flex text-[14px] whitespace-nowrap overflow-hidden lg:opacity-0 lg:group-hover:opacity-100 lg:group-hover:w-[var(--max-width)]"
                        >
                            Descargar CV
                        </p>
                    </div>
                    <div
                        id="downloadCv"
                        class="absolute w-[stretch] bottom-full left-1/2 lg:static flex flex-col h-0 lg:w-0 duration-300 overflow-hidden border-x border-t lg:border-0 bg-(--bg)"
                    >
                        <a
                            href="/digital/Ezequiel%20Arena%20CV.pdf"
                            target="_blank"
                            class="ps-2 lg:ps-4 my-1 whitespace-nowrap w-fit justify-end lg:justify-start"
                            >Version digital</a
                        >
                        <a
                            href="/print/Ezequiel%20Arena%20CV.pdf"
                            target="_blank"
                            class="ps-2 lg:ps-4 whitespace-nowrap w-fit justify-end lg:justify-start"
                            >Version imprimir</a
                        >
                    </div>
                </div>
                <div id="intro" class="flex items-center cursor-pointer">
                    <div
                        class="flex items-center justify-center min-w-[2.5rem]"
                    >
                        <Icon
                            id="on"
                            name="line-md:pause-to-play-filled-transition"
                            class="w-5 h-6 text-center duration-500"
                        />
                        <Icon
                            id="off"
                            name="line-md:play-off-filled"
                            class="w-5 h-6 text-center opacity-0 duration-500"
                        />
                    </div>
                    <p
                        class="duration-500 hidden lg:flex text-[14px] whitespace-nowrap overflow-hidden lg:group-hover:w-[var(--max-width)]"
                    >
                        Saltar intro
                    </p>
                </div>
                <div id="mode" class="flex items-center cursor-pointer">
                    <div
                        class="flex items-center justify-center min-w-[2.5rem]"
                    >
                        <Icon
                            name="line-md:light-dark"
                            class="w-5 h-6 text-center"
                        />
                    </div>
                    <p
                        class="duration-500 hidden lg:flex text-[14px] whitespace-nowrap overflow-hidden lg:group-hover:w-[var(--max-width)]"
                    >
                        Modo claro
                    </p>
                </div>
            </div>
        </div>
        <div class="md:hidden content-center">
            <Icon
                name="line-md:chevron-right"
                class="w-6 h-6 text-center rounded-s-full"
            />
        </div>
    </div>
</section>

<script>
    import { mediaQ } from "@/scripts/nodes";

    document.addEventListener("DOMContentLoaded", () => {
        const modeBtn = document.querySelector("#mode");
        const textMode = modeBtn?.querySelector("p");
        const intro = document.querySelector("#intro");

        let actualMode: string = document.documentElement.classList.contains(
            "dark",
        )
            ? "dark"
            : "light";

        if (textMode) {
            textMode.innerText =
                actualMode === "dark" ? "Modo claro" : "Modo oscuro";
        }

        const applyTheme = (theme: string) => {
            if (theme === "dark") {
                document.documentElement.classList.add("dark");
            } else {
                document.documentElement.classList.remove("dark");
            }

            if (textMode) {
                textMode.classList.add("opacity-0");

                setTimeout(() => {
                    textMode.innerText =
                        theme === "dark" ? "Modo claro" : "Modo oscuro";
                    textMode.classList.remove("opacity-0");
                }, 500);
            }

            localStorage.setItem("theme", theme);
            actualMode = theme;
        };

        window
            .matchMedia("(prefers-color-scheme: dark)")
            .addEventListener("change", (event) => {
                if (!localStorage.getItem("theme")) {
                    const newTheme = event.matches ? "dark" : "light";
                    applyTheme(newTheme);
                }
            });

        if (!modeBtn) return;

        modeBtn.addEventListener("click", () => {
            const nextTheme = actualMode === "dark" ? "light" : "dark";
            applyTheme(nextTheme);
        });

        const menu = document.getElementById("menu");

        const hNav = document.getElementById("menuContainer");

        const positionMenu = (e: MediaQueryListEvent | MediaQueryList) => {
            if (!menu || !hNav) return;
            if (e.matches) {
                menu.style.top = "unset";
            } else {
                menu.style.top = `calc(50% - ${hNav?.offsetHeight / 2}px)`;
            }
        };

        positionMenu(mediaQ);

        mediaQ.addEventListener("change", positionMenu);

        const wNab =
            document.querySelectorAll<HTMLParagraphElement>("#menuContainer p");
        let widthMax: number = 0;

        wNab.forEach((w) => {
            const wElement = w.clientWidth;

            if (widthMax < wElement) {
                widthMax = wElement + 8;
            }
        });

        wNab.forEach((w) => {
            w.classList.add("lg:w-0", "lg:duration-300");

            w.style.setProperty("--max-width", `${widthMax}px`);
        });

        const downloadCv = document.getElementById("downloadCv");

        const containerCv = document.querySelector("#containerCv div");
        let openCV = false;

        const showCv = (e: MediaQueryListEvent | MediaQueryList) => {
            if (!downloadCv) return;

            if (openCV) {
                downloadCv.style.height = "0px";
                if (!e.matches) {
                    downloadCv.style.width = "0";
                } else {
                    downloadCv.style.width = "100%";
                }
                openCV = false;
            } else {
                downloadCv.style.width = "100%";
                downloadCv.style.height = "56px";
                openCV = true;
            }
        };

        containerCv?.addEventListener("click", () => {
            showCv(mediaQ);
        });

        menu?.addEventListener("mouseleave", () => {
            if (!downloadCv) return;
            openCV = true;
            showCv(mediaQ);
        });

        const elOn = document.getElementById("on");
        const elOff = document.getElementById("off");
        const introText = intro?.querySelector("p");

        const updateUI = (isAnimated: boolean) => {
            introText?.classList.add("opacity-0");

            if (isAnimated) {
                elOn?.classList.add("opacity-0");
                setTimeout(() => {
                    elOn?.classList.add("hidden");
                    elOff?.classList.remove("hidden");
                    if (introText) introText.textContent = "Saltar intro";
                    requestAnimationFrame(() => {
                        elOff?.classList.remove("opacity-0");
                        introText?.classList.remove("opacity-0");
                    });
                }, 450);
            } else {
                elOff?.classList.add("opacity-0");
                setTimeout(() => {
                    elOff?.classList.add("hidden");
                    elOn?.classList.remove("hidden");
                    if (introText) introText.textContent = "Ver intro";
                    requestAnimationFrame(() => {
                        elOn?.classList.remove("opacity-0");
                        introText?.classList.remove("opacity-0");
                    });
                }, 450);
            }
        };

        let isAnimated = window.localStorage.getItem("animation") === "true";

        if (isAnimated) {
            elOn?.classList.add("hidden", "opacity-0");
            elOff?.classList.remove("hidden", "opacity-0");

            setTimeout(() => {
                if (introText) introText.textContent = "Saltar intro";
                introText?.classList.remove("lg:opacity-0");
            }, 500);
        } else {
            elOff?.classList.add("hidden", "opacity-0");
            elOn?.classList.remove("hidden", "opacity-0");

            introText?.classList.add("lg:opacity-0");

            setTimeout(() => {
                if (introText) introText.textContent = "Ver intro";
                introText?.classList.remove("lg:opacity-0");
            }, 500);
        }
        intro?.addEventListener("click", () => {
            isAnimated = window.localStorage.getItem("animation") === "true";

            if (isAnimated) {
                window.localStorage.setItem("animation", "false");
                updateUI(false);
            } else {
                window.localStorage.setItem("animation", "true");
                window.location.reload();
                return;
            }
        });
    });
</script>
